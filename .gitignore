# ============================================================================
# Build / packaging artifacts
# ============================================================================
# PyInstaller output + intermediates
/dist/
/build/
*.spec.bak

# Frontend build output (also covered by frontend/.gitignore)
/frontend/dist/
/frontend/dist-ssr/

# Build logs
build.log
/frontend/build.log

# ============================================================================
# Stale runtime data (defensive — no longer written by current code)
# ============================================================================
# Earlier versions wrote dev-mode app data into <repo>/data/ and looked for
# a bundled Stockfish at <repo>/stockfish/. Both code paths are gone: dev
# and packaged .exe now share %LOCALAPPDATA%/ChessReview/, and Stockfish is
# auto-downloaded by sf_download.py. Keeping these entries so a stray
# folder doesn't get committed by accident.
/data/
/stockfish/

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
env/
ENV/

# ============================================================================
# Node / frontend
# ============================================================================
node_modules/
*.local
.npm
.pnpm-store
.yarn/cache
.yarn/install-state.gz

# ============================================================================
# Editor / IDE
# ============================================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ============================================================================
# Claude Code local state
# ============================================================================
# Per-user permission allowlist + transient lock files. Never commit these.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/plans/

# ============================================================================
# OS / misc
# ============================================================================
*.log
*.tmp
*.bak
